{
  "manifest_version": 3,
  "name": "DeepSeek WebMCP",
  "version": "0.5.0",
  "description": "Bounded local coding and owner-attached browser tools for the logged-in DeepSeek Web UI.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DeepSeek WebMCP",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "commands": {
    "toggle-work": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "Toggle Work on this tab"
    }
  }
}
