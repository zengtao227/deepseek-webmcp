{
  "manifest_version": 3,
  "name": "ChatGPT Scoped DNR Side Panel Spike",
  "version": "0.0.1",
  "description": "Isolated spike: test the minimum frame-policy override needed to run signed-in ChatGPT Web in Chrome Side Panel.",
  "permissions": [
    "sidePanel",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open ChatGPT Scoped DNR Spike"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-frame-probe.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://chatgpt.com;"
  }
}
