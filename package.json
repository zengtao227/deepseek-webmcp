{
  "name": "webmcp-extension",
  "version": "0.7.0",
  "private": true,
  "description": "Local coding tools for the logged-in DeepSeek Web UI through an isolated Docker runtime; no DeepSeek API key.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "lint": "node scripts/check-js.mjs",
    "check": "npm run lint && npm test",
    "setup": "node scripts/install-p2-native-host.mjs",
    "doctor": "node scripts/doctor.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "e2e": "node --test --test-concurrency=1 e2e/*.e2e.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "browser-webmcp-e2e": "file:../browser-webmcp-e2e"
  }
}
